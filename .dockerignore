# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
# Docker only recurses when the pattern starts with **/, so a bare
# `node_modules` matches the root one and nothing under apps/ or packages/.
# Without the ** the whole workspace's dependency and build output was being
# uploaded as build context, and tarring apps/*/.next/node_modules symlinks
# fails outright on Windows ("archive/tar: unknown file mode").
**/node_modules
.pnp
.pnp.js

# testing
**/coverage

# next.js / build output — regenerated inside the image
**/.next/
**/out/
**/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# python (upstream-sync tooling)
**/.venv
**/__pycache__
**/*.pyc

# turbo
**/.turbo

# vercel
.vercel
