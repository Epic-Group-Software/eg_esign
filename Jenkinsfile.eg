// eg-esign — Epic Group e-signature instance. Deploys to eg-k8s-01.
//
//   PR       -> checks only
//   staging  -> build + deploy to eg-esign-staging (esign-staging.epicgroup.ca)
//   main     -> build + deploy to eg-esign-prod    (esign.epicgroup.ca)
//
// Separate from the root Jenkinsfile, which deploys the Davinci SaaS instance.
// Step logic lives in jenkins/*.groovy.
//
// Runs on the shared Docker runner (label 'docker'), not as Kubernetes pod
// agents: the Davinci build cluster sits at 85-95% requested CPU, so pod
// agents (kaniko asked for 400m / 10Gi) waited indefinitely to schedule.
// Each tool still runs in its own pinned image, via docker.image().inside().

import groovy.json.JsonSlurper

pipeline {
    agent { label 'docker' }

    options {
        buildDiscarder(logRotator(numToKeepStr: '20'))
        timeout(time: 90, unit: 'MINUTES')
        timestamps()
        // Init does its own checkout with the GitHub credential below.
        skipDefaultCheckout()
    }

    environment {
        REGISTRY          = 'epicregistry.azurecr.io'
        REGISTRY_USERNAME = 'epicregistry'
        IMAGE_NAME        = 'epic-group-software/eg-esign'
        GIT_CREDENTIAL_ID = 'f1b484af-24eb-4f28-a57a-66db51117a73'
        // Jenkins job is 'eg-esign'; the GitHub repo is 'eg_esign'. Set it
        // explicitly so status/comment API calls hit the right repo.
        GITHUB_REPO       = 'eg_esign'
        // jenkins-agent.service runs with ProtectHome=read-only; tool state
        // (docker login, npm, trivy) goes under the agent workDir instead.
        HOME              = '/opt/jenkins/home'
    }

    stages {
        stage('Init') {
            steps {
                script {
                    sh 'mkdir -p "$HOME"'
                    checkout([
                        $class: 'GitSCM',
                        branches: scm.branches,
                        extensions: scm.extensions,
                        userRemoteConfigs: [[
                            url: scm.userRemoteConfigs[0].url,
                            credentialsId: env.GIT_CREDENTIAL_ID,
                        ]],
                    ])

                    // Every stage shares this one workspace on the runner.
                    env.GIT_COMMIT_SHORT = env.GIT_COMMIT.take(7)

                    def helpers = load 'jenkins/helpers.groovy'

                    // Jenkins' PR merge-commit SHA doesn't exist on GitHub, so
                    // statuses against it would be invisible. Use the PR head.
                    if (env.CHANGE_ID) {
                        helpers.withGitHubCredentials {
                            def body = sh(returnStdout: true, script: """#!/bin/bash
                                curl -sS -u "\$GIT_USER:\$GIT_PASS" \
                                    "https://api.github.com/repos/Epic-Group-Software/${helpers.getRepoName()}/pulls/${env.CHANGE_ID}"
                            """)
                            env.STATUS_COMMIT_SHA = new JsonSlurper().parseText(body)?.head?.sha
                        }
                        echo "PR head SHA for GitHub statuses: ${env.STATUS_COMMIT_SHA}"
                    }

                    // Anything not listed here is checks-only.
                    if (env.BRANCH_NAME == 'main') {
                        env.ENVN = 'prod'
                        env.NAMESPACE = 'eg-esign-prod'
                        env.HOST = 'esign.epicgroup.ca'
                        env.TAG = 'prod'
                        env.CRED = '-prod'
                    } else if (env.BRANCH_NAME == 'staging') {
                        env.ENVN = 'staging'
                        env.NAMESPACE = 'eg-esign-staging'
                        env.HOST = 'esign-staging.epicgroup.ca'
                        env.TAG = 'staging'
                        env.CRED = '-staging'
                    }

                    env.IMAGE_TAG = "${env.TAG ?: 'pr'}-${env.BUILD_NUMBER}-${env.GIT_COMMIT_SHORT}"

                    // Mark every check pending up front so all of them appear
                    // on the PR immediately. Otherwise the ones that run later
                    // in the shared Quality pod stay invisible until the
                    // earlier ones finish.
                    if (env.CHANGE_ID) {
                        ['Lint', 'Unit Tests', 'Build & Typecheck', 'Security Scan', 'Helm Lint'].each {
                            helpers.notifyGitHub(it, 'pending', 'Queued')
                        }
                    }

                    echo """eg-esign build configuration:
  Branch:    ${env.BRANCH_NAME}
  PR:        ${env.CHANGE_ID ?: 'n/a'}
  Env:       ${env.ENVN ?: 'checks only'}
  Namespace: ${env.NAMESPACE ?: 'n/a'}
  Image tag: ${env.IMAGE_TAG}"""
                }
            }
        }

        // Lint, tests, typecheck and helm lint gate the PR, not the merge — by
        // the time a commit reaches staging/main they have already passed on
        // exactly that change, and re-running them delayed every deploy by
        // ~12 minutes. Security Scan still runs on push, because a secret can
        // reach a branch without ever going through a PR. Matches the
        // Project-Operations split.
        stage('Checks') {
            parallel {
                stage('Quality') {
                    when {
                        changeRequest()
                        beforeAgent true
                    }
                    steps {
                        script {
                            def checks = load 'jenkins/checks.groovy'
                            checks()
                        }
                    }
                }

                stage('Security Scan') {
                    options { timeout(time: 20, unit: 'MINUTES') }
                    steps {
                        script {
                            def helpers = load 'jenkins/helpers.groovy'
                            helpers.withGitHubStatus('Security Scan') {
                                def securityScan = load 'jenkins/security-scan.groovy'
                                securityScan()
                            }
                        }
                    }
                }

                stage('Helm Lint') {
                    when {
                        changeRequest()
                        beforeAgent true
                    }
                    options { timeout(time: 5, unit: 'MINUTES') }
                    steps {
                        script {
                            def helpers = load 'jenkins/helpers.groovy'
                            helpers.withGitHubStatus('Helm Lint') {
                                def helmLint = load 'jenkins/helm-lint.groovy'
                                helmLint()
                            }
                        }
                    }
                }
            }
        }

        stage('Build Image') {
            when { anyOf { branch 'main'; branch 'staging' } }
            steps {
                script {
                    def buildImage = load 'jenkins/build-image.groovy'
                    buildImage()
                }
            }
        }

        stage('Deploy') {
            when { anyOf { branch 'main'; branch 'staging' } }
            options { timeout(time: 25, unit: 'MINUTES') }
            steps {
                script {
                    def deploy = load 'jenkins/deploy.groovy'
                    deploy()
                }
            }
        }
    }

    post {
        success {
            echo "eg-esign pipeline succeeded" + (env.ENVN ? " — deployed to ${env.ENVN} (https://${env.HOST})" : '')
        }
        failure {
            echo 'eg-esign pipeline failed. See the stage logs above.'
        }
        // Shared runner: leave no checkout or node_modules behind.
        cleanup {
            cleanWs(notFailBuild: true)
        }
    }
}

